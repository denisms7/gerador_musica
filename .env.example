# ---------------------------------------------------------------------------
# Servidor de inferencia ACE-Step (processo separado, mantem o modelo na VRAM)
# ---------------------------------------------------------------------------
MUSICGEN_ACESTEP_BASE_URL=http://127.0.0.1:8001
MUSICGEN_ACESTEP_HOME=C:/Projetos/ACE-Step-1.5
MUSICGEN_ACESTEP_API_KEY=

# Perfil de modelo. Use `python scripts/diagnose.py` para a recomendacao.
# 6-12GB VRAM  -> acestep-v15-turbo + acestep-5Hz-lm-0.6B
# 12-16GB VRAM -> acestep-v15-turbo + acestep-5Hz-lm-1.7B
# O ACE-Step classifica 8GB como tier3 e so aceita o LM 0.6B.
MUSICGEN_DIT_MODEL=acestep-v15-turbo
MUSICGEN_LM_MODEL=acestep-5Hz-lm-0.6B

# ---------------------------------------------------------------------------
# Geracao
# ---------------------------------------------------------------------------
MUSICGEN_DEFAULT_STEPS=8
MUSICGEN_DEFAULT_GUIDANCE=7.0
MUSICGEN_DEFAULT_BATCH=2
MUSICGEN_AUDIO_FORMAT=wav
MUSICGEN_JOB_TIMEOUT_S=1800
MUSICGEN_POLL_INTERVAL_S=3.0

# ---------------------------------------------------------------------------
# Pos-processamento
# ---------------------------------------------------------------------------
MUSICGEN_TARGET_LUFS=-14.0
MUSICGEN_ENABLE_LOUDNESS=true
MUSICGEN_ENABLE_STEMS=false
MUSICGEN_DEMUCS_MODEL=htdemucs

# ---------------------------------------------------------------------------
# Armazenamento
# ---------------------------------------------------------------------------
MUSICGEN_DATA_DIR=./data
MUSICGEN_DB_PATH=./data/musicgen.db
